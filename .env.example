# Kopier til .env. Bruk bare dine egne ressurser.
# VITE_* er offentlige byggevariabler. Andre verdier skal bare finnes på serveren.

# Servernøklene trengs før oppstartsveiviseren kan teste eller endre databasen.
# Bruk bare en instans du administrerer; loopback/private adresser støttes lokalt.
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Valgfri: Postgres-tilkobling som lar veiviseren kjøre migrasjonene i en tom
# database. Lokalt postgresql://postgres:postgres@127.0.0.1:54322/postgres.
# Fjern den når oppsettet er ferdig.
SUPABASE_DB_URL=""
# Samme adresse og publishable key for nettleseren; uten dem kan ingen logge inn.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Adresse og valg fra oppstartsveiviseren.
VITE_SITE_URL="http://localhost:8080"
VITE_OPEN_LAYOUT="hvit"
# Sett true først når du har skrevet egne vilkår og personvernerklæring.
VITE_OPEN_LEGAL_PAGES="false"
# Må samsvare med e-postbekreftelse i Supabase Auth.
VITE_OPEN_EMAIL="true"
# E-post utestengte brukere kan kontakte. Tom: ingen kontakt vises.
VITE_SUPPORT_EMAIL=""
VITE_ENVIRONMENT="production"
PUBLIC_SITE_URL=""

# Egen tilfeldig serverhemmelighet for HMAC av klient-IP-er.
RATE_LIMIT_HMAC_SECRET=""

# S3-kompatibel bildelagring. BILDER skal være offentlig, VEDLEGG privat.
# For R2: sett konto-ID. For annen S3-lagring: sett endpoint og region.
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_REGION=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BILDER_BUCKET=""
R2_VEDLEGG_BUCKET=""
R2_PUBLIC_BASE_URL=""
VITE_R2_PUBLIC_BASE_URL=""
# Samme tilfeldige hemmelighet som app_settings.r2_cleanup_secret.
R2_CLEANUP_SECRET=""

# Bygg for annen vert, f.eks. node-server. Tom verdi bruker Cloudflare Workers.
NITRO_PRESET=""
# Velg eget Worker-navn før eventuell deploy til din egen Cloudflare-konto.
CLOUDFLARE_WORKER_NAME="marketplace"
# Bak annen proxy: navnet på IP-headeren proxyen alltid overskriver.
CLIENT_IP_HEADER=""

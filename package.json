    "minimatch": "^9.0.5",
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1",
    "brace-expansion": "^2.1.5",
    "undici": "^8.12.2",
    "nanoid": "^3.3.17",
    "js-yaml": "^4.3.2",
    "sharp": "^0.35.5",
    "@xmldom/xmldom": "^0.9.12"
  },
  "patchedDependencies": {
    "eslint-plugin-jsx-a11y@6.10.2": "patches/eslint-plugin-jsx-a11y@6.10.2.patch"
  }
}

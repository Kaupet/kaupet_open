{
  "name": "kaupet",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "private": true,
  "sideEffects": [
    "./src/lib/zod-config.ts",
    "./src/lib/vehicle/register.ts",
    "./src/lib/boat/register.ts",
    "./src/lib/error-capture.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun run check:bundle",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/kaupet-quality/eslint",
    "lint:ci": "bun run lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:db-migration": "bun scripts/test-db-migrations.mjs",
    "test:rls": "node scripts/run-rls-tests.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:playwright": "playwright test",
    "format": "prettier --write . --cache --cache-strategy content --cache-location node_modules/.cache/kaupet-quality/prettier",
    "format:check": "prettier --check . --cache --cache-strategy content --cache-location node_modules/.cache/kaupet-quality/prettier",
    "check:server-boundary": "node scripts/check-server-boundary.mjs",
    "check:server-fn-auth": "node scripts/check-server-fn-auth.mjs",
    "check:rls-coverage": "node scripts/check-rls-coverage.mjs",
    "check:safe-area": "node scripts/check-safe-area.mjs",
    "check:side-effects": "node scripts/check-side-effects.mjs",
    "deploy": "nitro deploy --prebuilt",
    "postinstall": "node -e \"require('node:fs').rmSync('node_modules/.cache/kaupet-quality', { recursive: true, force: true })\" && lefthook install",
    "test:database": "node scripts/run-e2e.mjs --database-only"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
